{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "node --experimental-strip-types --no-warnings scripts/check-delivery-pricing-sync.mjs"
    ]
  },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "predeploy": [
      "node --experimental-strip-types --no-warnings scripts/check-delivery-pricing-sync.mjs"
    ],
    "rewrites": [
      { "source": "/gestion", "destination": "/gestion/index.html" },
      { "source": "/gestion/**", "destination": "/gestion/index.html" }
    ]
  }
}
