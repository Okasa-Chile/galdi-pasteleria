{
  "firestore": {
    "rules": "firestore.rules"
  },
  "functions": {
    "source": "functions",
    "predeploy": [
      "node --experimental-strip-types --no-warnings scripts/check-delivery-pricing-sync.mjs"
    ]
  },
  "hosting": {
    "public": "out",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "predeploy": [
      "node --experimental-strip-types --no-warnings scripts/check-delivery-pricing-sync.mjs"
    ],
    "rewrites": [
      { "source": "/gestion", "destination": "/gestion/index.html" },
      { "source": "/gestion/**", "destination": "/gestion/index.html" }
    ],
    "redirects": [
      { "source": "/pan-artesanal-maipu", "destination": "/productos", "type": 301 },
      { "source": "/pan-artesanal-maipu/", "destination": "/productos", "type": 301 }
    ],
    "headers": [
      {
        "source": "/_next/static/**",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
        ]
      },
      {
        "source": "**/*.@(webp|png|jpg|jpeg|ico|svg|gif)",
        "headers": [
          { "key": "Cache-Control", "value": "public, max-age=86400" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      },
      {
        "source": "**/!(*.*)",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache" }
        ]
      }
    ]
  }
}
